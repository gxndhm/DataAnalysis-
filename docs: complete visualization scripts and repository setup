import matplotlib.pyplot as plt
import seaborn as sns

# Setting the visual style for BTS standards (Section 2.10)
sns.set_theme(style="whitegrid")

# --- Figure 7: Parallel Computing Execution Time (Section 3.5) ---
# Data from Table 1 in the report
config = ['1 Worker\n(Serial)', '10 Workers\n(Parallel)', '20 Workers\n(Parallel)']
times = [148.42, 42.15, 26.88]

plt.figure(figsize=(10, 6))
bars = plt.bar(config, times, color=['#e74c3c', '#3498db', '#2ecc71'])
plt.ylabel('Execution Time (Seconds)')
plt.title('Serial vs Parallel Processing Execution Time Comparison')

# Adding data labels on top of bars
for bar in bars:
    yval = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2, yval + 2, f'{yval}s', ha='center', fontweight='bold')

plt.tight_layout()
plt.savefig('figure7_performance.png')
plt.show()

